# CreatorsHQ Backend Environment Configuration Example
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Additional exact CORS origins only; never use preview-domain or wildcard origins.
CORS_ALLOWED_ORIGINS=
# Production frontend URL has historically been listed as https://creatorshq.ai;
# verify the canonical frontend domain before setting FRONTEND_URL on Render.
# OAuth binding cookies are Secure and SameSite=None in production. Prefer
# same-site custom domains for frontend/backend to avoid third-party-cookie blocking.
# Production OAuth callbacks:
# GOOGLE_CALLBACK_URL=https://creators-hq-lz3d.onrender.com/api/auth/google/callback
# LINKEDIN_CALLBACK_URL=https://creators-hq-lz3d.onrender.com/api/auth/linkedin/callback

# Supabase Server-Side Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-browser
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# OpenAI Integration
OPENAI_API_KEY=your-openai-api-key-here

# Email Delivery
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=notifications@creatorshq.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@domain.com
SMTP_PASS=your-smtp-app-password

# Stripe Billing (Optional - V1 Beta operates on unlocked Beta tier)
STRIPE_SECRET_KEY=your-stripe-secret-key-here

